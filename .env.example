# ── LightningMate configuration ───────────────────────────────────────────────
# Copy this file to `.env` and fill in your node's values. Never commit `.env`.

# LND gRPC host:port. On Umbrel typically umbrel.local:10009 (Tor/LAN) or the
# container host lnd:10009 when LightningMate runs on the Umbrel itself.
LND_SOCKET=umbrel.local:10009

# --- Option A: paste base64-encoded values (recommended) ----------------------
# base64 -w0 .../tls.cert
LND_CERT=
# base64 -w0 .../data/chain/bitcoin/mainnet/readonly.macaroon  (READ-ONLY!)
LND_MACAROON=

# --- Option B: point to files instead of pasting base64 -----------------------
# LND's data dir, mounted read-only — in Docker e.g. -v <lnd data dir>:/lnd:ro
# (not under /data, which is the app's own state volume):
# LND_CERT_PATH=/lnd/tls.cert
# LND_MACAROON_PATH=/lnd/data/chain/bitcoin/mainnet/readonly.macaroon

# Backend HTTP port
PORT=3001

# Interface to bind. Default 127.0.0.1 = reachable only from this machine (safe
# for standalone, where no login is set). Binding anything else REQUIRES a login:
# set APP_PASSWORD (the app refuses to start otherwise). In a standalone Docker
# container the API must bind 0.0.0.0 — set both lines here (this file is what
# `docker run --env-file .env` reads). On Umbrel the app binds 0.0.0.0 and the
# API requires the per-app password Umbrel injects (APP_PASSWORD / APP_SEED, set
# by the compose); app_proxy sits in front too.
# LM_BIND=127.0.0.1
# APP_PASSWORD=choose-a-password

# Optional Host-header allowlist (comma-separated) to defend against DNS
# rebinding. Without a login it defaults to localhost, 127.0.0.1, ::1 and the
# LM_BIND address; set it if you open the UI under another name (e.g. behind
# an authenticating reverse proxy). e.g. LM_ALLOWED_HOSTS=umbrel.local
# Every API POST must be JSON and a request a browser marks as cross-site is
# refused, whatever this says (SECURITY.md).
# LM_ALLOWED_HOSTS=

# How far back to pull forwarding history for flow stats, in days
FLOW_WINDOW_DAYS=30

# ── Writes (fee apply + autopilot) — OFF by default ───────────────────────────
# Everything above is read-only. To let LightningMate APPLY fee changes, opt in
# here AND provide a write-capable macaroon: the admin macaroon works, or bake
# the least-privilege one SECURITY.md lists (peers:read included — every
# channel open checks its peer's connection with it).
# LM_ENABLE_WRITE=true
# LND_WRITE_MACAROON=          # base64 of the macaroon, OR:
# LND_WRITE_MACAROON_PATH=/lnd/data/chain/bitcoin/mainnet/admin.macaroon
# On Umbrel the admin macaroon is auto-discovered from the mounted data dir.

# Where the app keeps its state (settings, history, the Magma order journal,
# ledgers, the Amboss key). In the Docker image it is /data — mount a volume
# there (README: -v lightningmate-data:/data); Umbrel mounts the app's data dir
# there. Run from a checkout (npm run dev / start) it defaults to <repo>/.data.
# DATA_DIR=/data
