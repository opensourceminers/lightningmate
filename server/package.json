{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx --import ./test/setup.ts --test --test-timeout=600000 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "lightning": "^10.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
